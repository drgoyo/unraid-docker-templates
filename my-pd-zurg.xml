<?xml version="1.0"?>
<Container version="2">
  <Name>pd_zurg</Name>
  <Beta>false</Beta>
  <Category>Downloaders: MediaApp: MediaServer:</Category>
  <Repository>iampuid0/pd_zurg</Repository>
  <Registry>https://hub.docker.com/r/iampuid0/pd_zurg</Registry>

  <DonateText>Buy the Developers a Coffee!</DonateText>
  <DonateLink>https://github.com/I-am-PUID-0/pd_zurg#buy-itstoggle-a-beercoffee-</DonateLink>
  <DonateImg>https://raw.githubusercontent.com/I-am-PUID-0/pd_zurg/develop/assets/icon.png</DonateImg>

  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/I-am-PUID-0/pd_zurg/issues</Support>
  <Shell>bash</Shell>
  <GitHub>https://github.com/I-am-PUID-0/pd_zurg</GitHub>
  <ReadMe>https://github.com/I-am-PUID-0/pd_zurg</ReadMe>
  <Project>https://github.com/I-am-PUID-0/pd_zurg</Project>
  <Overview>Stream torrents directly to Plex/Emby/Jellyfin/Infuse through Debrid Services, using Plex Discover Watchlists, Trakt lists, and Overseerr. Leverages plex_debrid, zurg, and rclone combined in a single Docker image for faster deployment.</Overview>
  <TemplateURL></TemplateURL>
  <Icon>https://raw.githubusercontent.com/I-am-PUID-0/pd_zurg/develop/assets/icon.png</Icon>

  <ExtraParams>--cap-add SYS_ADMIN --device /dev/fuse:/dev/fuse:rwm --security-opt apparmor:unconfined --security-opt no-new-privileges --env RCLONE_MOUNT_OPTIONS="--allow-other --buffer-size 2G --vfs-cache-mode full --umask 002 --allow-non-empty"</ExtraParams>

  <Date></Date>
  <Changes></Changes>

  <Config Name="Path: /config" Target="/config" Default="/mnt/cache/appdata/pd_zurg/config" Mode="rw" Description="Required: Stores config files (settings.json, etc.). Create this folder if it doesn't exist." Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="Path: /log" Target="/log" Default="/mnt/cache/appdata/pd_zurg/log" Mode="rw" Description="Stores logs for troubleshooting. Create this folder if it doesn't exist." Type="Path" Display="always" Required="false" Mask="false"/>
  <Config Name="Path: /cache" Target="/cache" Default="/mnt/vmdisk/appdata/pd_zurg/cache" Mode="rw" Description="Optional: Cache for faster rclone operations (speeds up cloud access). Create this folder if you want to use caching." Type="Path" Display="always" Required="false" Mask="false"/>
  <Config Name="Path: /data" Target="/data" Default="/mnt/vmdisk/remotemount/pd_zurg" Mode="rshared" Description="Mount point for your Debrid cloud storage (e.g., RealDebrid). Make sure the 'nobody' user has read/write access." Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="Path: /zurg/RD" Target="/zurg/RD" Default="/mnt/cache/appdata/pd_zurg/RD" Mode="rw" Description="Location for Zurg RealDebrid active configuration." Type="Path" Display="always" Required="false" Mask="false"/> 

  <Environment>
    <Variable Name="PUID" Value="99" /> 
    <Variable Name="PGID" Value="100" /> 
    <Variable Name="TZ" Value="Europe/Berlin" />  

    <Variable Name="ZURG_ENABLED" Value="true" /> 
    <Variable Name="RD_API_KEY" Value="" /> 
    <Variable Name="ZURG_LOG_LEVEL" Value="INFO" />
    <Variable Name="ZURG_UPDATE" Value="true" /> 

    <Variable Name="PLEX_REFRESH" Value="true" />
    <Variable Name="PLEX_MOUNT_DIR" Value="/realdebrid" /> 
    <Variable Name="PLEX_USER" Value="" /> 
    <Variable Name="PLEX_TOKEN" Value="" /> 
    <Variable Name="PLEX_ADDRESS" Value="http://192.168.??.??:32400" /> 
    <Variable Name="RCLONE_MOUNT_NAME" Value="realdebrid" /> 

    <Variable Name="RCLONE_LOG_LEVEL" Value="INFO" />
    <Variable Name="RCLONE_CACHE_DIR" Value="/cache" /> 
    <Variable Name="RCLONE_VFS_CACHE_MODE" Value="full" />
    <Variable Name="RCLONE_VFS_CACHE_MAX_SIZE" Value="300G" />

    <Variable Name="PD_ENABLED" Value="true" />  
    <Variable Name="PD_UPDATE" Value="true" />  
    <Variable Name="SEERR_API_KEY" Value="" /> 
    <Variable Name="SEERR_ADDRESS" Value="192.168.??.???:5055" /> 
    <Variable Name="AUTO_UPDATE_INTERVAL" Value="12" /> 
    <Variable Name="DUPLICATE_CLEANUP" Value="true" />  
    <Variable Name="CLEANUP_INTERVAL" Value="1" />  
    <Variable Name="PDZURG_LOG_LEVEL" Value="INFO" />
    <Variable Name="PDZURG_LOG_COUNT" Value="25" />  
  </Environment>
</Container>



