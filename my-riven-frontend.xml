<?xml version="1.0"?>
<Container version="2">
  <Name>riven-frontend</Name>
  <Beta>false</Beta>
  <Category>MediaApp:WebGui</Category>
  <Repository>spoked/riven-frontend:dev</Repository>
  <Registry>https://hub.docker.com/r/spoked/riven-frontend</Registry>
  <Network>eth0</Network>
  <MyIP>192.168.31.232</MyIP>
  <Privileged>false</Privileged>
  <Support>https://github.com/rivenmedia/riven/issues</Support>
  <Shell>sh</Shell>
  <Project>https://github.com/rivenmedia/riven</Project>
  <Overview>Web UI for managing your Riven library and scrapers.</Overview>
  <WebUI>http://192.168.31.232:3000</WebUI>
  <Icon>https://raw.githubusercontent.com/rivenmedia/riven/main/assets/riven-light.png</Icon>

  <Config Name="Path: /riven/data" Target="/riven/data" Default="/mnt/vmdisk/appdata/riven/frontend" Mode="rw" Description="Frontend configuration storage." Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="BACKEND_URL" Target="BACKEND_URL" Default="http://[fdcf:bbfb:5598::233]:8080" Mode="" Description="IPv6 Backend URL for stable internal communication." Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="ORIGIN" Target="ORIGIN" Default="http://192.168.31.232:3000" Mode="" Description="The URL used to access the frontend." Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="BACKEND_API_KEY" Target="BACKEND_API_KEY" Default="7f23201bbfbfe889de586c21031c03e5" Mode="" Description="Must match the API Key in the Backend template." Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="AUTH_SECRET" Target="AUTH_SECRET" Default="p0eMfmV2WyG1jMflpBUVRFczpgieALCHrvJxu5d4pFQ=" Mode="" Description="Encryption secret for sessions." Type="Variable" Display="advanced" Required="true" Mask="true"/>
</Container>