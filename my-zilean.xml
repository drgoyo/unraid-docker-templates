<?xml version="1.0"?>
<Container version="2">
  <Name>zilean</Name>
  <Beta>false</Beta>
  <Category>MediaApp:Organization</Category>
  <Repository>ipromknight/zilean:latest</Repository>
  <Registry>https://hub.docker.com/r/ipromknight/zilean</Registry>
  <Network>eth0</Network>
  <MyIP>192.168.31.235</MyIP>
  <Privileged>false</Privileged>
  <Support>https://github.com/iPromKnight/zilean/issues</Support>
  <Shell>sh</Shell>
  <GitHub>https://github.com/iPromKnight/zilean</GitHub>
