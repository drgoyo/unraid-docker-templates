<?xml version="1.0"?>
<Container version="2">
  <Name>riven</Name>
  <Beta>false</Beta>
  <Category>MediaApp:Video MediaApp:Organization</Category>
  <Repository>spoked/riven:dev</Repository>
  <Registry>https://hub.docker.com/r/spoked/riven</Registry>
  <Network>eth0</Network>
  <MyIP>192.168.31.233</MyIP>
  <Privileged>false</Privileged>
  <Support>https://github.com/rivenmedia/riven/issues</Support>
  <Shell>bash</Shell>
  <GitHub>https://github.com/rivenmedia/riven</GitHub>
  <ReadMe>https://github.com/rivenmedia/riven</ReadMe>
  <Project>https://github.com/rivenmedia/riven</Project>
  <Overview>Riven is a high-performance media management engine for Real-Debrid.[br][br][b]CRITICAL SETUP:[/b][br]1. You MUST run the [b]riven-vfs-init[/b] User Script at array startup.[br]2. The /library path MUST be set to [b]RW: Slave[/b].[br]3. Config and Library MUST be in separate folders to avoid recursive loops.</Overview>
  <WebUI/>
  <Icon>https://raw.githubusercontent.com/rivenmedia/riven/main/assets/riven-dark.png</Icon>
  <ExtraParams>--cap-add=SYS_ADMIN --device=/dev/fuse --security-opt apparmor:unconfined --shm-size=2G</ExtraParams>

  <Config Name="Path: /library" Target="/library" Default="/mnt/vmdisk/realdebrid" Mode="rw:slave" Description="The FUSE mount point. MUST BE SET TO RW:SLAVE. Ensure your User Script has run 'mount --make-shared /mnt/vmdisk' first." Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="Path: /riven/data" Target="/riven/data" Default="/mnt/vmdisk/appdata/riven/data" Mode="rw" Description="Persistent metadata and database storage." Type="Path" Display="always" Required="true" Mask="false"/>
  
  <Config Name="RIVEN_DATABASE_HOST" Target="RIVEN_DATABASE_HOST" Default="postgresql+psycopg2://postgres:ff800ef8ca4f49a45d7bc63a@[fdcf:bbfb:5598::234]:5432/riven" Mode="" Description="Postgres connection string using Dual-Stack IPv6." Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="RIVEN_API_KEY" Target="RIVEN_API_KEY" Default="7f23201bbfbfe889de586c21031c03e5" Mode="" Description="API Key for frontend communication." Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="RIVEN_FILESYSTEM_MOUNT_PATH" Target="RIVEN_FILESYSTEM_MOUNT_PATH" Default="/library" Mode="" Description="Internal container path for the VFS mount." Type="Variable" Display="advanced" Required="true" Mask="false"/>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="TZ" Target="TZ" Default="Europe/Berlin" Mode="" Description="Timezone" Type="Variable" Display="always" Required="false" Mask="false"/>
</Container>